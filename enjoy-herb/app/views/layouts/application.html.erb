<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>Enjoy Herb — メモ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <main>
      <header class="site-header">
        <a href="<%= notes_path %>" class="brand">🌱 Enjoy Herb</a>
        <span>小さなメモ帳</span>
      </header>
      <% if notice.present? %>
        <p class="notice" role="status"><%= notice %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
